DEEPSEEK_API_KEY=pon-tu-clave-aqui
DEEPSEEK_MODEL=deepseek-chat
# OpenCode Go (API compatible con OpenAI). La clave vive solo en el backend.
OPENCODE_GO_API_KEY=pon-tu-clave-aqui
OPENCODE_GO_MODEL=glm-5.3-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
HOST=127.0.0.1
TOGETHER_API_KEY=pon-tu-clave-nueva-aqui
TOGETHER_TEXT_MODEL=Qwen/Qwen3.5-9B
# Ilustraciones dinámicas: modelo GPT Image, nunca FLUX/Leonardo.
OPENAI_API_KEY=pon-tu-clave-aqui
OPENAI_IMAGE_MODEL=gpt-image-1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/cuentos
# true solo para proveedores PostgreSQL remotos que exigen TLS.
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
# Checkout Pro: usa credenciales de prueba primero. Nunca expongas este token al frontend.
MERCADO_PAGO_ACCESS_TOKEN=TEST-pon-tu-access-token-aqui
# URL HTTPS pública que Mercado Pago podrá llamar para confirmar pagos.
PUBLIC_URL=https://cuentos.benielstudio.app
