{
  "name": "maticuentos",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "npm run build && node scripts/verify-mvp-library.mjs",
    "qa:e2e": "node --input-type=module -e \"console.log('Ejecuta tests/qa-journey.mjs con browser_run_code_unsafe(filename) de Playwright MCP, usando la extensión en Chrome estable.')\"",
    "preview": "vite preview",
    "optimize:images": "node scripts/optimize-images.mjs",
    "branch:generate": "node --env-file=server/.env scripts/branch-gen/extract-source.mjs && node --env-file=server/.env scripts/branch-gen/generate.mjs",
    "branch:assemble": "node scripts/branch-gen/assemble.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "lucide-react": "0.468.0",
    "playwright-core": "^1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.11"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3"
  }
}
