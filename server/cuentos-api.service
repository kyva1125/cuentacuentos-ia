[Unit]
Description=Cuentos DeepSeek API
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/beniel/projects-mvp/cuentos/server
Environment=PORT=3100
Environment=HOST=0.0.0.0
EnvironmentFile=/home/beniel/projects-mvp/cuentos/server/.env
Environment=DEEPSEEK_MODEL=deepseek-chat
Environment=ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://maticuentos.benielstudio.app,https://cuentos-lake.vercel.app,https://cuentos-nick-ledesmas-projects.vercel.app
ExecStart=/usr/bin/node /home/beniel/projects-mvp/cuentos/server/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
